default: &default
  pool: <%= ENV.fetch('RAILS_MAX_THREADS', 5) %>
  checkout_timeout: 5
  reaping_frequency: 10

development:
  shard01:
    <<: *default
    adapter: postgresql
    encoding: unicode
    host: <%= ENV.fetch('SHARD01_DB_HOST', 'localhost') %>
    port: <%= ENV.fetch('SHARD01_DB_PORT', 5432) %>
    database: <%= ENV.fetch('SHARD01_DB_NAME', 'app_development') %>
    username: <%= ENV.fetch('SHARD01_DB_USERNAME', 'postgres') %>
    password: <%= ENV.fetch('SHARD01_DB_PASSWORD', '') %>

test:
  shard01:
    <<: *default
    adapter: postgresql
    encoding: unicode
    host: <%= ENV.fetch('SHARD01_DB_HOST', 'localhost') %>
    port: <%= ENV.fetch('SHARD01_DB_PORT', 5432) %>
    database: <%= ENV.fetch('SHARD01_DB_NAME', 'app_test') %>
    username: <%= ENV.fetch('SHARD01_DB_USERNAME', 'postgres') %>
    password: <%= ENV.fetch('SHARD01_DB_PASSWORD', '') %>

production:
  shard01:
    <<: *default
    url: <%= ENV['SHARD01_DATABASE_URL'] %>
